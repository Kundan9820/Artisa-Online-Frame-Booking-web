# Copy this file to .env and fill in real values before deploying.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=0

# Database
# Default (no config needed): SQLite file at artista_frame.db
# For MySQL in production, uncomment and fill in:
# DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:3306/artista_frame

# Shop WhatsApp number (digits only, with country code, no + or spaces)
SHOP_WHATSAPP_NUMBER=919006090994

# Port (used by some hosts like Render/Railway)
PORT=5000
